	"styles": {
		"color": {
			"background": "var:preset|color|canvas",
			"text": "var:preset|color|body"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "fontFamily": "var:preset|font-family|serif", "lineHeight": "1.15" }
			},
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|accent" } }
			},
			"button": {
				"color": { "background": "var:preset|color|primary", "text": "var:preset|color|canvas" },
				"border": { "radius": "0" },
				"spacing": { "padding": { "top": "0.875rem", "right": "1.75rem", "bottom": "0.875rem", "left": "1.75rem" } },
				"typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|sm", "fontWeight": "500", "textTransform": "uppercase", "letterSpacing": "0.08em" },
				":hover": { "color": { "background": "var:preset|color|body", "text": "var:preset|color|canvas" } },
				":focus": { "outline": { "color": "var:preset|color|primary", "offset": "3px", "style": "solid", "width": "2px" } }
			}
		},
			"elements": {
				"textInput": {
					"border": { "color": "var:preset|color|border", "radius": "0", "width": "1px" },
					"color": { "text": "var:preset|color|body", "background": "var:preset|color|canvas" }
				}
			},
			"blocks": {
			"core/search": {
				"color": { "text": "var:preset|color|primary" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
